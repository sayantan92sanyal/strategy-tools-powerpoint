<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Strategy Tools ribbon. To add a button: copy a <button> line, give it a
     new id, label and onAction (a Rb_ callback in src/modRibbon.bas). -->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="stTab" label="Strategy Tools">

        <group id="stFormat" label="Format">
          <button id="stSwap" label="Swap" size="large" imageMso="RecurrenceEdit"
                  onAction="Rb_Swap" screentip="Swap objects"
                  supertip="Select exactly 2 objects. They trade places (by their centres)."/>
          <button id="stSameSize" label="Same Size" imageMso="ShapeRectangle"
                  onAction="Rb_SameSize" screentip="Same size"
                  supertip="Select 2+ objects. All get the width and height of the first one you clicked."/>
          <button id="stSameWidth" label="Same Width" imageMso="TableColumnsDistribute"
                  onAction="Rb_SameWidth" screentip="Same width"
                  supertip="Select 2+ objects. All get the width of the first one you clicked."/>
          <button id="stSameHeight" label="Same Height" imageMso="TableRowsDistribute"
                  onAction="Rb_SameHeight" screentip="Same height"
                  supertip="Select 2+ objects. All get the height of the first one you clicked."/>
          <button id="stTitle" label="Title Harmonizer" size="large" imageMso="FormatPainter"
                  onAction="Rb_TitleHarmonizer" screentip="Title Harmonizer"
                  supertip="Click into a slide title. Every other slide's title gets the same font and size (Title Slide layouts are skipped)."/>
          <button id="stCorners" label="Same Corners" image="stCorners"
                  onAction="Rb_SameCorners" screentip="Same corner rounding"
                  supertip="Select 2+ rounded shapes. All get the corner rounding of the first one you clicked, whatever their size."/>
          <button id="stMatch" label="Match Format" image="stMatch"
                  onAction="Rb_MatchFormat" screentip="Match format"
                  supertip="Select 2+ objects. Fill, outline, shadow and font of the first one you clicked are copied to the others."/>
        </group>

        <group id="stVisuals" label="Visuals">
          <menu id="stHarvey" label="Harvey Ball" size="large" image="stHv75" itemSize="large"
                screentip="Harvey ball"
                supertip="Adds a Harvey ball. Select existing Harvey balls first to change their level.">
            <button id="stHarvey0" image="stHv0"   label="0% (empty)"  tag="0"   onAction="Rb_Harvey"/>
            <button id="stHarvey25" image="stHv25"  label="25%"         tag="25"  onAction="Rb_Harvey"/>
            <button id="stHarvey50" image="stHv50"  label="50%"         tag="50"  onAction="Rb_Harvey"/>
            <button id="stHarvey75" image="stHv75"  label="75%"         tag="75"  onAction="Rb_Harvey"/>
            <button id="stHarvey100" image="stHv100" label="100% (full)" tag="100" onAction="Rb_Harvey"/>
          </menu>
          <menu id="stMeter" label="Meter" size="large" image="stMeterMedium" itemSize="large"
                screentip="Meter"
                supertip="Adds a 3-bar meter. Select existing meters first to change their level.">
            <button id="stMeterLow" image="stMeterLow"    label="Low (1 bar)"     tag="1" onAction="Rb_Meter"/>
            <button id="stMeterMedium" image="stMeterMedium" label="Medium (2 bars)" tag="2" onAction="Rb_Meter"/>
            <button id="stMeterHigh" image="stMeterHigh"   label="High (3 bars)"   tag="3" onAction="Rb_Meter"/>
          </menu>
          <menu id="stStatus" label="Status" size="large" image="stStatusComplete" itemSize="large"
                screentip="Status icon"
                supertip="Adds a status icon. Select existing status icons first to change them.">
            <button id="stStatusComplete" image="stStatusComplete"   label="Complete (green tick)"     tag="COMPLETE"   onAction="Rb_Status"/>
            <button id="stStatusInProgress" image="stStatusInProgress" label="In progress (amber)"       tag="INPROGRESS" onAction="Rb_Status"/>
            <button id="stStatusDelayed" image="stStatusDelayed"    label="Delayed (red cross)"       tag="DELAYED"    onAction="Rb_Status"/>
            <button id="stStatusNotStarted" image="stStatusNotStarted" label="Not started (grey)"        tag="NOTSTARTED" onAction="Rb_Status"/>
          </menu>
          <button id="stChevrons" label="Chevrons" size="large" imageMso="SmartArtInsert"
                  onAction="Rb_Chevrons" screentip="Chevrons"
                  supertip="Asks how many, then adds a row of phase chevrons with a detail text box under each."/>
          <menu id="stTracker" label="Tracker" size="large" image="stTrackerNumber" itemSize="large"
                screentip="Tracker"
                supertip="Adds a numbered or lettered circle. Each click adds the next one on the slide.">
            <button id="stTrackerNumber" image="stTrackerNumber" label="Next number (1, 2, 3...)" onAction="Rb_TrackerNumber"/>
            <button id="stTrackerLetter" image="stTrackerLetter" label="Next letter (A, B, C...)" onAction="Rb_TrackerLetter"/>
            <button id="stTrackerCustom" image="stTrackerCustom" label="Custom text..."           onAction="Rb_TrackerCustom"/>
          </menu>
        </group>

        <group id="stFrameworks" label="Frameworks">
          <button id="stMatrix" label="2x2 Matrix" size="large" image="stMatrix"
                  onAction="Rb_Matrix" screentip="2x2 matrix"
                  supertip="Four shaded quadrants with editable titles and axis labels, filling the slide body."/>
          <button id="stProcess" label="Process Flow" size="large" image="stProcess"
                  onAction="Rb_ProcessFlow" screentip="Process flow"
                  supertip="Asks how many steps, then adds numbered circles on a line with a name and description under each."/>
          <button id="stTakeaway" label="Key Takeaways" size="large" image="stTakeaway"
                  onAction="Rb_Takeaways" screentip="Key takeaways panel"
                  supertip="A panel on the right of the slide with a Key takeaways header and a bulleted list."/>
          <menu id="stRatingMenu" label="Rating" size="large" image="stRating3" itemSize="large"
                screentip="Rating scale"
                supertip="One to five filled dots. Select existing ratings first to change their score.">
            <button id="stRating1" label="1 of 5" image="stRating1" onAction="Rb_Rating" tag="1"/>
            <button id="stRating2" label="2 of 5" image="stRating2" onAction="Rb_Rating" tag="2"/>
            <button id="stRating3" label="3 of 5" image="stRating3" onAction="Rb_Rating" tag="3"/>
            <button id="stRating4" label="4 of 5" image="stRating4" onAction="Rb_Rating" tag="4"/>
            <button id="stRating5" label="5 of 5" image="stRating5" onAction="Rb_Rating" tag="5"/>
          </menu>
          <button id="stCagr" label="CAGR Arrow" size="large" image="stCagr"
                  onAction="Rb_Cagr" screentip="CAGR arrow"
                  supertip="Select the first and last bar (or nothing), enter start value, end value and years. Adds an arrow with the growth rate per year."/>
        </group>

        <group id="stStory" label="Storyline">
          <menu id="stAgendaMenu" label="Agenda" size="large" image="stAgenda" itemSize="large"
                screentip="Agenda and dividers"
                supertip="Create an agenda you type section names into, then add highlighted agenda dividers before each section.">
            <button id="stAgendaNew"     label="New agenda..."    onAction="Rb_AgendaNew"/>
            <button id="stAgendaDivider" label="Divider here (before this slide)" onAction="Rb_AgendaDivider"/>
            <button id="stAgendaTags"    label="Add section tags to slides" onAction="Rb_SectionTags"/>
            <button id="stAgendaUpdate"  label="Update agenda"    onAction="Rb_AgendaUpdate"/>
          </menu>
          <button id="stStoryline" label="Storyline" size="large" image="stStoryline"
                  onAction="Rb_Storyline" screentip="Storyline"
                  supertip="Adds a slide at the end listing every slide's title, grouped by section, so you can read the storyline top to bottom."/>
          <button id="stDeckCheck" label="Deck Check" size="large" image="stDeckCheck"
                  onAction="Rb_DeckCheck" screentip="Deck check"
                  supertip="Lists problems on a report slide at the end: stray fonts, overflowing text, objects off the slide, empty placeholders, missing titles, leftover stamps and sticky notes."/>
        </group>

        <group id="stReview" label="Review">
          <menu id="stStampMenu" label="Stamp" size="large" image="stStamp" itemSize="large"
                screentip="Status stamp"
                supertip="Adds a stamp in the top-right corner of the selected slides. Picking another stamp re-labels it.">
            <button id="stStampDraft"        label="Draft"          onAction="Rb_StampDraft"/>
            <button id="stStampPrelim"       label="Preliminary"    onAction="Rb_StampPreliminary"/>
            <button id="stStampDiscussion"   label="For discussion" onAction="Rb_StampDiscussion"/>
            <button id="stStampConfidential" label="Confidential"   onAction="Rb_StampConfidential"/>
            <button id="stStampCustom"       label="Custom text..." onAction="Rb_StampCustom"/>
            <menuSeparator id="stStampSep"/>
            <button id="stStampAll"          label="Copy this slide's stamp to all slides" onAction="Rb_StampAll"/>
            <button id="stStampRemove"       label="Remove all stamps"  onAction="Rb_StampRemove"/>
          </menu>
          <menu id="stStickyMenu" label="Sticky Note" size="large" image="stSticky" itemSize="large"
                screentip="Sticky note"
                supertip="Yellow reviewer notes. Remove them all in one click before sending.">
            <button id="stStickyAdd"    label="Add sticky note"         onAction="Rb_StickyAdd"/>
            <button id="stStickyRemove" label="Remove all sticky notes" onAction="Rb_StickyRemove"/>
          </menu>
          <menu id="stFooterMenu" label="Source" size="large" image="stFooter" itemSize="large"
                screentip="Source &amp; note footer"
                supertip="Adds a Source (and optional Note) line at the bottom left, in the same spot on every slide.">
            <button id="stFooterSource" label="Source"        onAction="Rb_FooterSource"/>
            <button id="stFooterNote"   label="Note + Source" onAction="Rb_FooterSourceNote"/>
          </menu>
          <menu id="stBackupMenu" label="Back-up" size="large" image="stBackup" itemSize="large"
                screentip="Back-up label"
                supertip="Marks the selected slides as back-up, with an optional Appendix divider.">
            <button id="stBackupMark"   label="Mark as back-up"     onAction="Rb_BackupMark"/>
            <button id="stBackupRemove" label="Remove back-up label" onAction="Rb_BackupRemove"/>
          </menu>
          <button id="stClean" label="Clean for Sending" size="large" image="stClean"
                  onAction="Rb_CleanForSending" screentip="Clean for sending"
                  supertip="Saves a copy next to this deck without stamps, sticky notes, speaker notes or comments. This deck is not changed."/>
          <button id="stFonts" label="Fix Fonts" size="large" image="stFonts"
                  onAction="Rb_FixFonts" screentip="Fix fonts"
                  supertip="Finds fonts that aren't the template's and, after asking, replaces them everywhere."/>
        </group>

        <group id="stHelp" label="Help">
          <button id="stTextBox" label="Text Box" imageMso="TextBoxInsert"
                  onAction="Rb_TextBox" screentip="New text box (Ctrl+Q)"
                  supertip="Drops a ready-to-type text box in the middle of the slide."/>
          <button id="stShortcuts" label="Shortcuts" size="large" imageMso="Help"
                  onAction="Rb_Shortcuts" screentip="Shortcuts cheat sheet (Cmd+Shift+O)"
                  supertip="Opens a list of PowerPoint for Mac shortcuts, including the Strategy Tools ones."/>
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
